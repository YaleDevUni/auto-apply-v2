# ─────────────────────────────────────────────────────────────
# 어댑터 선택 (ARCHITECTURE.md §11.4 composition root)
#   전부 오프라인 값으로 두면 LLM/브라우저/봇 없이 파이프라인 실행 가능
# ─────────────────────────────────────────────────────────────
APP_ENV=local                  # local | prod
LLM_PROVIDER=stub              # stub | anthropic | claude_cli (API 키 대신 로컬 `claude login` 구독)
STORAGE=local                  # local | memory | s3
NOTIFIER=console               # console | telegram
RESUME_ENGINE=simple           # simple | langgraph   (langgraph 는 M3)
REPOSITORY=file                # memory | file | postgres  (postgres 는 `make up` + `make migrate` 필요)
EXECUTOR=replay                # replay | playwright
PLAYWRIGHT_HEADLESS=true       # false 로 두면 supervised 실행을 눈으로 볼 수 있다
JOB_SOURCE=fixture             # fixture | live  (live 는 wanted/saramin/jasoseol 실제 요청)
MATCHING_CONFIG=yaml           # static | yaml
PROFILE_SOURCE=yaml            # static | yaml  (config/profile.yaml — 이름/연락처/학력/스킬태그/언어)
GUIDE_SOURCE=file              # static | file  (config/resume_guide.{platform}.md — REVISE(general)로 쌓이는 규칙)
PDF_RENDERER=weasyprint        # stub | weasyprint  (stub 는 JSON 덤프, 실제 PDF 는 weasyprint)

# ─────────────────────────────────────────────────────────────
# 인프라
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://auto_apply:auto_apply@localhost:5432/auto_apply
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
DATA_DIR=./var                 # LocalBlobStore 루트
MATCHING_CONFIG_PATH=./config/matching.yaml   # MATCHING_CONFIG=yaml 일 때만
RESUME_GUIDE_DIR=./config      # GUIDE_SOURCE=file 일 때만. resume_guide.{platform}.md 를 이 안에서 찾는다

# S3 / MinIO (STORAGE=s3 일 때만)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=auto-apply
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_TEST_BUCKET=auto-apply-test  # S3BlobStore contract test 전용, 운영 S3_BUCKET과 분리

# ─────────────────────────────────────────────────────────────
# 외부 서비스 (필요한 어댑터를 켤 때만 채운다)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# LLM_PROVIDER=claude_cli 일 때만 — 이 머신에서 미리 `claude login` 해둬야 한다
CLAUDE_CLI_BINARY=claude
CLAUDE_CLI_MODEL=claude-sonnet-5
CLAUDE_CLI_MAX_BUDGET_USD=0.5
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=     # 쉼표 구분. 이 봇은 실제 제출 권한을 가진 콘솔이다
# 채팅 에이전트(telegram/agent.py)의 도구 선택 판단 전용 모델 — 이력서 생성(ANTHROPIC_MODEL/
# CLAUDE_CLI_MODEL)보다 가벼운 분류 작업이라 기본값을 Haiku로 둔다.
TELEGRAM_AGENT_MODEL=claude-haiku-4-5-20251001
# 채팅 에이전트의 start_applications 도구가 새 지원을 시작할 때 쓰는 user_id.
# config/profile.yaml 의 user_id 와 맞춰야 한다.
DEFAULT_USER_ID=u1

# scripts/auto_login.py 전용 (본인 계정) — var/auth/{platform}.json 세션 만료 시 자동 재로그인.
# CAPTCHA/추가 인증이 뜨면 우회하지 않고 실패시킨다 — 그때는 scripts/save_auth_state.py 로
# 사람이 직접 로그인해라.
SARAMIN_USERNAME=
SARAMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 안전장치 (ARCHITECTURE.md §9.5)
# ─────────────────────────────────────────────────────────────
DRY_RUN_ONLY=true              # true 면 어떤 경우에도 최종 submit 을 하지 않는다
APPROVAL_TIMEOUT_HOURS=72
MAX_REVISIONS=10               # 이 라운드를 넘으면 사람에게 넘긴다 (수정요청 무한루프 방지)
MAX_GUIDE_REVISIONS=5          # 가이드 patch 제안 💬 코멘트 재시도 한도

# 이력서 블록 개수 상한 — 자연어 가이드 patch 로는 못 바꾸는 숫자값이라 여기 둔다
# (domain/resume_blocks.select_relevant_blocks)
RESUME_MAX_PROJECT_BLOCKS=20            # 안전 상한일 뿐 — 실제 개수는 resume_guide.{platform}.md 가 정한다
RESUME_MAX_CAREER_BLOCKS_PER_ENTITY=20  # 안전 상한일 뿐 — 실제 개수는 resume_guide.{platform}.md 가 정한다

# 워크플로우 능동 감시 (`make watchdog`) — FAILED/TERMINATED/TIMED_OUT 을 텔레그램으로 알린다
WATCHDOG_POLL_INTERVAL_SECONDS=60
WATCHDOG_LOOKBACK_MINUTES=60   # 재시작 직후 이만큼 과거까지 다시 훑는다 (워터마크 비영속)
WATCHDOG_BLIND_ALERT_AFTER=3   # 폴링 연속 실패 이 횟수에서 "감시가 눈이 멀었다"를 알린다
