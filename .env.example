# ─────────────────────────────────────────────────────────────
# 어댑터 선택 (bootstrap.py — 어댑터를 생성하는 유일한 곳, §A2)
#   전부 오프라인 값으로 두면 LLM 없이 파이프라인 실행 가능
# ─────────────────────────────────────────────────────────────
APP_ENV=local                  # local | prod
LLM_PROVIDER=stub              # stub | anthropic | claude_cli (API 키 대신 로컬 `claude login` 구독)
STORAGE=local                  # local | memory
RESUME_ENGINE=simple           # simple
REPOSITORY=sqlite              # sqlite | memory  (sqlite 는 DATA_DIR/db.sqlite3, 스키마는 alembic — 프로필·경험·답변KB 포함)
GUIDE_SOURCE=file              # static | file  (DATA_DIR/guides/resume_guide.{platform}.md)

# ─────────────────────────────────────────────────────────────
# 저장소 (D3·D4 — SQLite + 로컬 파일, 외부 인프라 없음)
# ─────────────────────────────────────────────────────────────
DATA_DIR=./var                 # db.sqlite3 · files/(LocalBlobStore 루트) · guides/

# ─────────────────────────────────────────────────────────────
# 외부 서비스 (필요한 어댑터를 켤 때만 채운다)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# LLM_PROVIDER=claude_cli 일 때만 — 이 머신에서 미리 `claude login` 해둬야 한다
CLAUDE_CLI_BINARY=claude
CLAUDE_CLI_MODEL=claude-sonnet-5
CLAUDE_CLI_MAX_BUDGET_USD=0.5

# ─────────────────────────────────────────────────────────────
# 안전장치 (00-product 절대 규칙)
# ─────────────────────────────────────────────────────────────
DRY_RUN_ONLY=true              # true 면 어떤 경우에도 최종 submit 을 하지 않는다
APPROVAL_TIMEOUT_HOURS=72
MAX_REVISIONS=10               # 이 라운드를 넘으면 사람에게 넘긴다 (수정요청 무한루프 방지)

# 이력서 블록 개수 안전 상한 (domain/resume_blocks.select_relevant_blocks) — 프롬프트 폭주 방지용
RESUME_MAX_PROJECT_BLOCKS=20
RESUME_MAX_CAREER_BLOCKS_PER_ENTITY=20

# ─────────────────────────────────────────────────────────────
# 웹 콘솔 · 업로드 (§A10 · §A7)
# ─────────────────────────────────────────────────────────────
# CORS·Origin 으로 허용할 웹 콘솔 출처 하나 (127.0.0.1/localhost 만). 비우면 개발 모드에서는
# http://localhost:5173, 설치본에서는 같은 출처만 허용한다.
WEB_CORS_ORIGIN=
DOCUMENT_MAX_BYTES=10485760    # 업로드 파일 한 개 상한 (기본 10 MiB)
